{
  "name": "honelens-video",
  "version": "1.0.0",
  "private": true,
  "description": "HoneLENS product videos (short 55 s vertical, long 2:40 landscape), built with Remotion. Rendered on GitHub Actions.",
  "scripts": {
    "sync": "node scripts/sync-brand.mjs",
    "audio": "node scripts/make-audio.mjs",
    "studio": "npm run sync && remotion studio src/index.ts",
    "typecheck": "npm run sync && tsc --noEmit",
    "still": "remotion still src/index.ts",
    "render": "remotion render src/index.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.526",
    "@remotion/cli": "4.0.526",
    "@remotion/renderer": "4.0.526",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
